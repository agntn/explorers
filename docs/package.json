{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot.mjs",
    "fixtures": "node scripts/record-fixtures.mjs",
    "dev": "nuxt dev --extends docus",
    "build": "pnpm snapshot && NUXT_SITE_URL=https://explorers.agntn.dev nuxt build --extends docus",
    "generate": "NUXT_SITE_URL=https://explorers.agntn.dev nuxt generate --extends docus",
    "preview": "nuxt preview --extends docus",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@agntn/chains": "0.3.4",
    "better-sqlite3": "12.11.1",
    "docus": "5.13.0",
    "jiti": "2.7.0",
    "nuxt": "4.5.2",
    "ofetch": "1.5.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.128",
    "@iconify-json/simple-icons": "1.2.96",
    "@iconify-json/token": "1.2.40",
    "@iconify-json/vscode-icons": "1.2.76",
    "wrangler": "4.128.0"
  },
  "packageManager": "pnpm@11.3.0"
}
