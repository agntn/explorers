{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot.mjs",
    "fixtures": "node scripts/record-fixtures.mjs",
    "dev": "nuxt dev --extends docus",
    "build": "pnpm snapshot && NUXT_SITE_URL=https://explorers.agntn.dev nuxt build --extends docus",
    "generate": "NUXT_SITE_URL=https://explorers.agntn.dev nuxt generate --extends docus",
    "preview": "nuxt preview --extends docus",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@agntn/chains": "catalog:deps",
    "better-sqlite3": "catalog:deps",
    "docus": "catalog:deps",
    "h3": "catalog:deps",
    "jiti": "catalog:deps",
    "nuxt": "catalog:deps",
    "ohash": "catalog:deps",
    "zod": "catalog:deps"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:dev",
    "@iconify-json/simple-icons": "catalog:dev",
    "@iconify-json/token": "catalog:dev",
    "@iconify-json/vscode-icons": "catalog:dev",
    "@nuxt/content": "catalog:dev",
    "@nuxt/ui": "catalog:dev",
    "@vueuse/core": "catalog:dev",
    "shiki": "catalog:dev",
    "typescript": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "packageManager": "pnpm@12.15.0"
}
