{
  "name": "@oritwoen/explorers",
  "version": "0.1.0",
  "description": "Unified multi-chain block explorer provider library for AI agents",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/oritwoen/explorers#readme",
  "bugs": {
    "url": "https://github.com/oritwoen/explorers/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oritwoen/explorers.git"
  },
  "bin": {
    "explorers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/pi/extensions"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "latest",
    "chains": "file:../chains",
    "obuild": "^0.4.36",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.22.4",
    "typebox": "^1.1.39",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
